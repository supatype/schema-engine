    "functions": [
      {
        "schema": "_platform",
        "name": "set_categories_slug",
        "identityArguments": "",
        "identityTypes": "",
        "returnType": "trigger",
        "language": "plpgsql",
        "volatility": "v",
        "securityDefiner": false,
        "body": "\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    IF NEW.\"slug\" IS NULL OR BTRIM(NEW.\"slug\"::TEXT) = '' THEN\n      NEW.\"slug\" = _platform.slugify(NEW.\"name\"::TEXT);\n    END IF;\n  ELSIF TG_OP = 'UPDATE' THEN\n    IF NEW.\"name\" IS DISTINCT FROM OLD.\"name\" THEN\n      IF OLD.\"slug\" IS NOT DISTINCT FROM _platform.slugify(OLD.\"name\"::TEXT) THEN\n        NEW.\"slug\" = _platform.slugify(NEW.\"name\"::TEXT);\n      END IF;\n    END IF;\n  END IF;\n  RETURN NEW;\nEND;\n",
        "comment": null,
        "arguments": "",
        "config": [],
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "cost": "100",
        "rows": "0",
        "definition": "CREATE OR REPLACE FUNCTION _platform.set_categories_slug()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    IF NEW.\"slug\" IS NULL OR BTRIM(NEW.\"slug\"::TEXT) = '' THEN\n      NEW.\"slug\" = _platform.slugify(NEW.\"name\"::TEXT);\n    END IF;\n  ELSIF TG_OP = 'UPDATE' THEN\n    IF NEW.\"name\" IS DISTINCT FROM OLD.\"name\" THEN\n      IF OLD.\"slug\" IS NOT DISTINCT FROM _platform.slugify(OLD.\"name\"::TEXT) THEN\n        NEW.\"slug\" = _platform.slugify(NEW.\"name\"::TEXT);\n      END IF;\n    END IF;\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
        "acl": [
          "PUBLIC=EXECUTE"
        ]
      },
      {
        "schema": "_platform",
        "name": "set_updated_at",
        "identityArguments": "",
        "identityTypes": "",
        "returnType": "trigger",
        "language": "plpgsql",
        "volatility": "v",
        "securityDefiner": false,
        "body": "\nBEGIN\n  NEW.updated_at = NOW();\n  RETURN NEW;\nEND;\n",
        "comment": null,
        "arguments": "",
        "config": [],
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "cost": "100",
        "rows": "0",
        "definition": "CREATE OR REPLACE FUNCTION _platform.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  NEW.updated_at = NOW();\n  RETURN NEW;\nEND;\n$function$\n",
        "acl": [
          "PUBLIC=EXECUTE"
        ]
      },
      {
        "schema": "_platform",
        "name": "slugify",
        "identityArguments": "val text",
        "identityTypes": "text",
        "returnType": "text",
        "language": "plpgsql",
        "volatility": "i",
        "securityDefiner": false,
        "body": "\nBEGIN\n  RETURN lower(\n    regexp_replace(\n      regexp_replace(\n        unaccent(trim(val)),\n        '[^a-zA-Z0-9\\s-]', '', 'g'\n      ),\n      '[\\s-]+', '-', 'g'\n    )\n  );\nEND;\n",
        "comment": null,
        "arguments": "val text",
        "config": [],
        "strict": false,
        "leakproof": false,
        "parallel": "u",
        "cost": "100",
        "rows": "0",
        "definition": "CREATE OR REPLACE FUNCTION _platform.slugify(val text)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\nAS $function$\nBEGIN\n  RETURN lower(\n    regexp_replace(\n      regexp_replace(\n        unaccent(trim(val)),\n        '[^a-zA-Z0-9\\s-]', '', 'g'\n      ),\n      '[\\s-]+', '-', 'g'\n    )\n  );\nEND;\n$function$\n",
        "acl": [
          "PUBLIC=EXECUTE"
        ]
      },
