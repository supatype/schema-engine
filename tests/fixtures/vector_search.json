{
  "astVersion": 2,
  "models": [
    {
      "name": "Document",
      "fields": {
        "id": {
          "kind": "uuid",
          "primaryKey": true,
          "required": true,
          "default": {
            "kind": "genRandomUuid"
          },
          "annotations": {
            "db": {
              "pgType": "UUID",
              "unique": false
            }
          }
        },
        "title": {
          "kind": "text",
          "required": true,
          "annotations": {
            "db": {
              "pgType": "TEXT",
              "unique": false
            }
          }
        },
        "content": {
          "kind": "text",
          "required": true,
          "annotations": {
            "db": {
              "pgType": "TEXT",
              "unique": false
            }
          }
        },
        "embedding": {
          "kind": "vector",
          "required": false,
          "dimensions": 1536,
          "annotations": {
            "db": {
              "pgType": "vector(1536)"
            }
          }
        },
        "metadata": {
          "kind": "json",
          "required": false,
          "annotations": {
            "db": {
              "pgType": "JSONB"
            }
          }
        },
        "source": {
          "kind": "text",
          "required": false,
          "annotations": {
            "db": {
              "pgType": "TEXT",
              "unique": false
            }
          }
        },
        "score": {
          "kind": "float",
          "required": false,
          "annotations": {
            "db": {
              "pgType": "DOUBLE PRECISION",
              "unique": false
            }
          }
        }
      },
      "options": {
        "timestamps": true,
        "softDelete": false
      },
      "annotations": {
        "db": {
          "tableName": "documents",
          "indexes": [
            {
              "fields": [
                "embedding"
              ],
              "unique": false,
              "using": "hnsw"
            }
          ]
        },
        "platform": {
          "access": {
            "read": {
              "type": "public"
            },
            "create": {
              "type": "role",
              "roles": [
                "admin",
                "ingest"
              ]
            },
            "update": {
              "type": "role",
              "roles": [
                "admin"
              ]
            },
            "delete": {
              "type": "role",
              "roles": [
                "admin"
              ]
            }
          }
        }
      }
    }
  ]
}
