{
  "models": [
    {
      "name": "Author",
      "tableName": "authors",
      "fields": {
        "id":       { "kind": "uuid",  "pgType": "UUID", "primaryKey": true, "required": true, "unique": false, "default": { "kind": "genRandomUuid" } },
        "name":     { "kind": "text",  "pgType": "TEXT", "required": true, "unique": false },
        "email":    { "kind": "email", "pgType": "TEXT", "required": true, "unique": true  },
        "bio":      { "kind": "text",  "pgType": "TEXT", "required": false,"unique": false },
        "avatar":   { "kind": "image", "pgType": "JSONB","required": false, "bucket": "avatars" }
      },
      "access": {},
      "indexes": [],
      "options": { "timestamps": true, "softDelete": false }
    },
    {
      "name": "Article",
      "tableName": "articles",
      "fields": {
        "id":       { "kind": "uuid",     "pgType": "UUID",  "primaryKey": true, "required": true, "unique": false, "default": { "kind": "genRandomUuid" } },
        "title":    { "kind": "text",     "pgType": "TEXT",  "required": true,  "unique": false },
        "slug":     { "kind": "slug",     "pgType": "TEXT",  "required": true,  "unique": true, "from": "title" },
        "body":     { "kind": "richText", "pgType": "JSONB", "required": true,  "unique": false },
        "excerpt":  { "kind": "text",     "pgType": "TEXT",  "required": false, "unique": false },
        "authorId": { "kind": "relation", "cardinality": "belongsTo", "target": "Author", "foreignKey": "author_id", "onDelete": "restrict" },
        "searchVector": { "kind": "tsVector", "pgType": "TSVECTOR", "required": false, "unique": false, "index": false }
      },
      "access": {
        "read": { "type": "public" },
        "create": { "type": "role", "roles": ["editor","admin"] },
        "update": { "type": "role", "roles": ["editor","admin"] },
        "delete": { "type": "role", "roles": ["admin"] }
      },
      "indexes": [
        { "fields": ["search_vector"], "unique": false, "using": "gin" },
        { "fields": ["author_id"], "unique": false, "using": "btree" }
      ],
      "options": { "timestamps": true, "softDelete": true }
    },
    {
      "name": "Tag",
      "tableName": "tags",
      "fields": {
        "id":   { "kind": "uuid", "pgType": "UUID", "primaryKey": true, "required": true, "unique": false, "default": { "kind": "genRandomUuid" } },
        "name": { "kind": "text", "pgType": "TEXT", "required": true,  "unique": true  },
        "slug": { "kind": "slug", "pgType": "TEXT", "required": true,  "unique": true, "from": "name" }
      },
      "access": {},
      "indexes": [],
      "options": { "timestamps": false, "softDelete": false }
    },
    {
      "name": "ArticleTag",
      "tableName": "articles",
      "fields": {
        "articles": { "kind": "relation", "cardinality": "manyToMany", "target": "Tag", "through": "article_tags" }
      },
      "access": {},
      "indexes": [],
      "options": { "timestamps": false, "softDelete": false }
    }
  ]
}
